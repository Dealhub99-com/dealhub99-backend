# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/dealhub99_db?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# JWT Configuration
# Generate a secure key (e.g., using a random string generator) and place it here
JWT_SECRET=your_super_secret_jwt_key_that_is_long_enough_for_security_reasons
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=2592000000

# SMTP Configuration (Gmail Example)
# If using Gmail, use an App Password instead of your real account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
